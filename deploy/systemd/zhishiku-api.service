[Unit]
Description=Zhishiku API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=zhishiku
Group=zhishiku
WorkingDirectory=/opt/zhishiku/current
EnvironmentFile=/etc/zhishiku/kb.env
ExecStart=/usr/bin/java -Xms256m -Xmx768m -jar /opt/zhishiku/current/kb-app.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zhishiku
UMask=0077

[Install]
WantedBy=multi-user.target
