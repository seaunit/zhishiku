{
  "name": "@zhishiku/waffo-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit && node --check scripts/smoke-checkout.mjs && node --check scripts/setup-catalog.mjs && node --check scripts/catalog-sync.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:checkout": "node scripts/smoke-checkout.mjs",
    "catalog:setup": "node scripts/setup-catalog.mjs"
  },
  "dependencies": {
    "@waffo/pancake-ts": "0.26.0"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
